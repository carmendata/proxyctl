{
  "_comment": "Ingress Proxy Configuration",
  "_deploy_on": "EPHEMERAL ingress proxy servers (replaced weekly)",
  "_location": "/etc/proxyctl/ingress.json (or baked into image)",
  "ingress": {
    "reserved_ips": [
      "203.0.113.200",
      "203.0.113.201"
    ],
    "backends": {
      "type": "consul",
      "url": "http://consul.internal:8500",
      "refresh_interval": "30s",
      "path": ""
    },
    "ssl": {
      "type": "vault",
      "vault_url": "https://vault.internal:8200",
      "vault_path": "secret/haproxy/ssl",
      "directory": ""
    },
    "health_checks": {
      "enabled": true,
      "interval": "10s",
      "timeout": "5s",
      "path": "/health",
      "method": "GET"
    },
    "algorithm": "roundrobin"
  },
  "haproxy": {
    "config_file": "/etc/haproxy/haproxy.cfg",
    "binary": "/usr/sbin/haproxy",
    "socket_file": "/run/haproxy/admin.sock",
    "stats_port": 9000,
    "stats_user": "",
    "stats_pass": ""
  },
  "daemon": {
    "enabled": true,
    "pid_file": "/var/run/ingressctl-daemon.pid",
    "log_file": "/var/log/ingressctl-daemon.log",
    "interval": "30s",
    "worker_pool": 5
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "/var/log/ingressctl.log"
  },
  "alerts": [
    {
      "type": "slack",
      "enabled": true,
      "failures_only": true,
      "config": {
        "webhook_url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
        "channel": "#ingress-alerts",
        "username": "ingressctl"
      }
    }
  ],
  "_note": "Note for ephemeral deployments:",
  "_note1": "- This config is typically baked into the server image",
  "_note2": "- Backend and SSL configs pulled from remote sources (Consul, Vault)",
  "_note3": "- Server can be destroyed/recreated weekly without data loss",
  "_note4": "- Reserved IPs are reassigned to new servers automatically"
}
