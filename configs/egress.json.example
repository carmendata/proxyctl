{
  "_comment": "Egress Proxy Configuration",
  "_deploy_on": "PERMANENT egress proxy server",
  "_location": "/etc/proxyctl/egress.json",
  "mode": "egress",
  "egress": {
    "private_ip": "10.16.0.5",
    "public_ip": "203.0.113.100",
    "port": 8080,
    "acl_file": "/etc/haproxy/acl.lst",
    "auto_reload": true,
    "checks": {
      "enabled": true,
      "interval": "1h",
      "parallel": true,
      "ssh_user": "root",
      "ssh_key": "/root/.ssh/id_rsa",
      "timeout": "30s"
    }
  },
  "haproxy": {
    "config_file": "/etc/haproxy/haproxy.cfg",
    "binary": "/usr/sbin/haproxy",
    "socket_file": "/run/haproxy/admin.sock",
    "stats_port": 9000,
    "stats_user": "",
    "stats_pass": ""
  },
  "daemon": {
    "enabled": true,
    "pid_file": "/var/run/egressctl-daemon.pid",
    "log_file": "/var/log/egressctl-daemon.log",
    "interval": "5m",
    "worker_pool": 10
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "/var/log/egressctl.log"
  },
  "alerts": [
    {
      "type": "slack",
      "enabled": true,
      "failures_only": true,
      "config": {
        "webhook_url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
        "channel": "#ops-alerts",
        "username": "egressctl"
      }
    }
  ]
}
