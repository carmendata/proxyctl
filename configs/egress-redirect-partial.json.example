{
  "_comment": "Worker Server with Partial Redirect (v0.8.0+)",
  "_deploy_on": "Internal worker server",
  "_location": "/etc/proxyctl/egress.json",
  "_description": "Redirects only specific destination IPs through egress proxy (Phase 2 testing)",
  "proxy": "10.16.0.5",
  "redirect": {
    "enabled": true,
    "type": "partial",
    "targets": [
      "8.8.8.8",
      "1.1.1.1",
      "208.67.222.222"
    ]
  }
}
