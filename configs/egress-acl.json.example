{
  "_comment": "Egress Proxy - ACL Management Only",
  "_use_case": "Minimal config for ACL management on egress proxy server",
  "_location": "/etc/proxyctl/egress.json",
  "_commands": "egressctl acl add|remove|list|reload, egressctl server check",

  "proxy": {
    "ip": "10.16.0.5",
    "port": 8080
  },
  "acl": {
    "file": "/etc/haproxy/acl.lst"
  }
}
