# Integration Test Configuration
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# Required: DigitalOcean API Token
# Get your token from: https://cloud.digitalocean.com/account/api/tokens
DO_API_TOKEN=your-digitalocean-api-token-here

# Optional: DigitalOcean region (default: lon1)
# List regions: doctl compute region list
# DO_REGION=lon1

# Optional: Droplet size (default: s-1vcpu-1gb)
# List sizes: doctl compute size list
# DO_DROPLET_SIZE=s-1vcpu-1gb

# Optional: Test timeout in seconds (default: 1800 = 30 minutes)
# TEST_TIMEOUT=1800

# Optional: Allow uncommitted changes (not recommended, skips status file)
# ALLOW_DIRTY=false

# Optional: Keep old log files from previous runs (default: false, cleans up old logs)
# KEEP_LOGS=false

# Optional: Keep droplets alive after tests for manual inspection (default: true = cleanup)
# Useful for debugging test failures - SSH connection details will be in log files
# CLEANUP=false

# Notes:
# - Environment variables set in your shell take precedence over .env values
# - .env file is ignored by git (credentials won't be committed)
# - Only DO_API_TOKEN is required, all others have sensible defaults
# - See test/integration/README.md for complete documentation
# - When CLEANUP=false, remember to manually delete droplets when done debugging:
#   doctl compute droplet delete $(doctl compute droplet list --tag-name proxyctl-test --format ID --no-header)
